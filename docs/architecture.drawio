  <diagram id="c4-container-view" name="Container View: Calculator System">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="850" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
    <!-- Person: User -->
    <mxCell id="user_head" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="380" y="20" width="60" height="60" as="geometry" />
    </mxCell>
    <mxCell id="user_body" value="&lt;b style=&quot;font-size: 14px; color: #2E7D32;&quot;&gt;User / Evaluator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #2E7D32;&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;An engineer or evaluator performing calculations using mouse clicks, touch, or a physical keyboard / numpad.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;arcSize=15;align=center;" vertex="1" parent="1">
      <mxGeometry x="300" y="70" width="220" height="90" as="geometry" />
    </mxCell>
    
    <!-- System Boundary -->
    <mxCell id="sys_boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0284C7;strokeWidth=2.5;arcSize=5;" vertex="1" parent="1">
      <mxGeometry x="60" y="230" width="700" height="530" as="geometry" />
    </mxCell>
    <mxCell id="boundary_label" value="&lt;b style=&quot;font-size: 14px; color: #0284C7;&quot;&gt;Calculator System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Software System — Docker Compose]&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="80" y="715" width="280" height="35" as="geometry" />
    </mxCell>
    
    <!-- Static Content -->
    <mxCell id="c_static_tab" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="90" y="255" width="70" height="20" as="geometry" />
    </mxCell>
    <mxCell id="c_static" value="&lt;b style=&quot;font-size: 14px; color: #0284C7;&quot;&gt;Static Content&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Container: Nginx Web Server]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Serves compiled HTML, CSS (soft pastel palette &amp;amp; circular keys), and TypeScript/React bundle.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=8;align=center;" vertex="1" parent="1">
      <mxGeometry x="90" y="270" width="200" height="120" as="geometry" />
    </mxCell>
    
    <!-- UI Container -->
    <mxCell id="c_ui_bar" value="•••" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=10;align=left;spacingLeft=8;fontColor=#0284C7;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="400" y="255" width="220" height="20" as="geometry" />
    </mxCell>
    <mxCell id="c_ui" value="&lt;b style=&quot;font-size: 14px; color: #0284C7;&quot;&gt;Web UI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Container: React 19 &amp;amp; TypeScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Single-page application providing an interactive Material You calculator interface with dual-line display and physical keyboard support.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;Port: 3000&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=8;align=center;" vertex="1" parent="1">
      <mxGeometry x="400" y="270" width="220" height="150" as="geometry" />
    </mxCell>
    
    <!-- Backend API Container -->
    <mxCell id="c_backend" value="&lt;b style=&quot;font-size: 14px; color: #0284C7;&quot;&gt;&amp;gt; _ Backend API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Container: Go 1.22+ and net/http]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Provides arithmetic calculation services, floating-point precision sanitization, CORS, and request logging via a REST/JSON API.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;Port: 8080&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=8;align=center;" vertex="1" parent="1">
      <mxGeometry x="400" y="470" width="220" height="145" as="geometry" />
    </mxCell>
    
    <!-- Session Storage -->
    <mxCell id="c_storage" value="&lt;b style=&quot;font-size: 14px; color: #0284C7;&quot;&gt;Session Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Container: Browser LocalStorage]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Stores recent calculation history locally across browser sessions.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;align=center;" vertex="1" parent="1">
      <mxGeometry x="110" y="475" width="180" height="135" as="geometry" />
    </mxCell>
    
    <!-- Swagger UI System -->
    <mxCell id="sys_swagger" value="&lt;b style=&quot;font-size: 14px; color: #0D9488;&quot;&gt;API Documentation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0D9488;&quot;&gt;[Embedded OpenAPI 3.0 / Swagger UI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Self-contained interactive Swagger interface embedded at &lt;b&gt;/swagger&lt;/b&gt; for testing API endpoints.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;arcSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="840" y="360" width="220" height="130" as="geometry" />
    </mxCell>
    
    <!-- User to Static Content -->
    <mxCell id="rel_u_static" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="user_body" target="c_static_tab">
      <mxGeometry relative="1" as="geometry">
        <Array points="340 190; 125 190" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_u_static" value="Loads the UI from&lt;br&gt;[HTTP:3000]" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_u_static">
      <mxGeometry x="0.2" relative="1" as="geometry"><mxPoint y="-5" as="offset" /></mxGeometry>
    </mxCell>

    <!-- User to Web UI -->
    <mxCell id="rel_u_ui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="user_body" target="c_ui_bar">
      <mxGeometry relative="1" as="geometry">
        <Array points="470 190; 510 190" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_u_ui" value="Enters calculations and&lt;br&gt;views results using" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_u_ui">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-5" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Static Content to Web UI -->
    <mxCell id="rel_static_ui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c_static" target="c_ui">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_static_ui" value="Delivers" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_static_ui">
      <mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-5" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Web UI to Backend API -->
    <mxCell id="rel_ui_be" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c_ui" target="c_backend">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_ui_be" value="Makes API requests to&lt;br&gt;[JSON/HTTP:8080]" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_ui_be">
      <mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="65" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Web UI to Session Storage -->
    <mxCell id="rel_ui_store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.3;" edge="1" parent="1" source="c_ui" target="c_storage">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_ui_store" value="Reads from and&lt;br&gt;writes to [Browser API]" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_ui_store">
      <mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Backend API to Swagger UI -->
    <mxCell id="rel_be_swag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c_backend" target="sys_swagger">
      <mxGeometry relative="1" as="geometry">
        <Array points="740 542; 740 425" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_be_swag" value="Serves interactive&lt;br&gt;OpenAPI docs at /swagger" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_be_swag">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-5" as="offset" /></mxGeometry>
    </mxCell>

    <!-- User to Swagger UI -->
    <mxCell id="rel_u_swag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="user_body" target="sys_swagger">
      <mxGeometry relative="1" as="geometry">
        <Array points="950 115" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_u_swag" value="Explores &amp;amp; tests REST API using&lt;br&gt;[HTTP:8080/swagger]" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="rel_u_swag">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>
    
    <!-- Footer Caption -->
    <mxCell id="c4_footer" value="&lt;b style=&quot;font-size: 13px; color: #1E293B;&quot;&gt;Container View: Calculator System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10.5px; color: #64748B;&quot;&gt;The container diagram for the Full-Stack Calculator System | Inspired by Simon Brown C4 Model (c4model.com)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="60" y="775" width="700" height="40" as="geometry" />
    </mxCell>
    
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-dynamic-view" name="Dynamic View: Request Flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="520" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
    <mxCell id="dyn_u_head" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="90" y="60" width="50" height="50" as="geometry" />
    </mxCell>
    <mxCell id="dyn_u_body" value="&lt;b style=&quot;font-size: 13px; color: #2E7D32;&quot;&gt;User&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #2E7D32;&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Types &lt;b&gt;&quot;50 + 25 =&quot;&lt;/b&gt; on screen or physical keyboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;arcSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="30" y="100" width="170" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="dyn_ui_bar" value="•••" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=10;align=left;spacingLeft=8;fontColor=#0284C7;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="300" y="85" width="180" height="18" as="geometry" />
    </mxCell>
    <mxCell id="dyn_ui_box" value="&lt;b style=&quot;font-size: 13px; color: #0284C7;&quot;&gt;Web UI (SPA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Container: React 19]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Captures key events, resets display cleanly, and prepares request&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="300" y="100" width="180" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="dyn_be_box" value="&lt;b style=&quot;font-size: 13px; color: #0284C7;&quot;&gt;&amp;gt; _ Backend API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Container: Go 1.22+]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Logs request latency, validates CORS, and decodes JSON payload&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;arcSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="580" y="100" width="190" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="dyn_eng_box" value="&lt;b style=&quot;font-size: 13px; color: #0D9488;&quot;&gt;Domain Engine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0D9488;&quot;&gt;[Component: internal/calculator]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Executes calculation &amp;amp; sanitizes IEEE-754 precision&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;arcSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="870" y="100" width="190" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="dyn_store_box" value="&lt;b style=&quot;font-size: 13px; color: #0284C7;&quot;&gt;Session Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #0284C7;&quot;&gt;[Browser LocalStorage]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #374151;&quot;&gt;Persists equation history for session recall&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;align=center;" vertex="1" parent="1">
      <mxGeometry x="315" y="320" width="150" height="90" as="geometry" />
    </mxCell>
    
    <!-- Step 1: User types input -->
    <mxCell id="d_step1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="dyn_u_body" target="dyn_ui_box">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step1" value="1. Enters input&lt;br&gt;[Clicks / Keydown]" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step1">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="5" y="-12" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 2: HTTP POST /api/v1/calculate -->
    <mxCell id="d_step2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="dyn_ui_box" target="dyn_be_box">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step2" value="2. POST /api/v1/calculate&lt;br&gt;{&quot;operation&quot;: &quot;add&quot;, &quot;a&quot;: 50, &quot;b&quot;: 25}" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step2">
      <mxGeometry x="-0.05" relative="1" as="geometry"><mxPoint y="-15" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 3: Call domain Add -->
    <mxCell id="d_step3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="dyn_be_box" target="dyn_eng_box">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step3" value="3. calculator.Add(50, 25)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step3">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="5" y="-12" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 4: Return float sanitized result -->
    <mxCell id="d_step4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="dyn_eng_box" target="dyn_be_box">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step4" value="4. Returns result: 75.0" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step4">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint x="5" y="12" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 5: HTTP 200 OK -->
    <mxCell id="d_step5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="dyn_be_box" target="dyn_ui_box">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step5" value="5. HTTP 200 OK&lt;br&gt;{&quot;success&quot;: true, &quot;result&quot;: 75}" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step5">
      <mxGeometry x="0.05" relative="1" as="geometry"><mxPoint y="15" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 6: Render to user -->
    <mxCell id="d_step6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="dyn_ui_box" target="dyn_u_body">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step6" value="6. Renders &quot;75&quot;&lt;br&gt;on bold display" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step6">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint x="5" y="14" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 7: Persist history -->
    <mxCell id="d_step7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="dyn_ui_box" target="dyn_store_box">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="d_lbl_step7" value="7. Saves &quot;50 + 25 = 75&quot; to history" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#374151;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="d_step7">
      <mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="75" as="offset" /></mxGeometry>
    </mxCell>
    
    <!-- Footer Caption -->
