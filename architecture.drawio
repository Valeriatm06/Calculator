    <mxCell id="line_user" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94A3B8;" edge="1" parent="1" source="part_user">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="140" y="180" as="sourcePoint" />
        <mxPoint x="140" y="780" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 2. React UI Component -->
    <mxCell id="part_ui" value="&lt;b&gt;React UI Components&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(Keypad.tsx / Display.tsx)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="270" y="130" width="170" height="45" as="geometry" />
    </mxCell>
    <mxCell id="line_ui" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94A3B8;" edge="1" parent="1" source="part_ui">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="355" y="180" as="sourcePoint" />
        <mxPoint x="355" y="780" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 3. useCalculator Hook -->
    <mxCell id="part_hook" value="&lt;b&gt;useCalculator Hook&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(State &amp;amp; isNewInputRef)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;fontColor=#831843;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="490" y="130" width="170" height="45" as="geometry" />
    </mxCell>
    <mxCell id="line_hook" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94A3B8;" edge="1" parent="1" source="part_hook">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="575" y="180" as="sourcePoint" />
        <mxPoint x="575" y="780" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 4. HTTP Client (api.ts) -->
    <mxCell id="part_api" value="&lt;b&gt;API Client&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(api.ts / fetch)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="710" y="130" width="150" height="45" as="geometry" />
    </mxCell>
    <mxCell id="line_api" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94A3B8;" edge="1" parent="1" source="part_api">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="785" y="180" as="sourcePoint" />
        <mxPoint x="785" y="780" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 5. Go Router & Middleware -->
    <mxCell id="part_mw" value="&lt;b&gt;Router &amp;amp; Middleware&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(ServeMux, Logger, CORS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="910" y="130" width="180" height="45" as="geometry" />
    </mxCell>
    <mxCell id="line_mw" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94A3B8;" edge="1" parent="1" source="part_mw">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="1000" y="180" as="sourcePoint" />
        <mxPoint x="1000" y="780" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- 6. Go Domain Service -->
    <mxCell id="part_domain" value="&lt;b&gt;Domain Calculator&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(internal/calculator)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1140" y="130" width="180" height="45" as="geometry" />
    </mxCell>
    <mxCell id="line_domain" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94A3B8;" edge="1" parent="1" source="part_domain">
      <mxGeometry width="50" height="50" relative="1" as="geometry">
        <mxPoint x="1230" y="180" as="sourcePoint" />
        <mxPoint x="1230" y="780" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- Sequence Steps -->
    <!-- Step 1: User types 55 -->
    <mxCell id="msg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="140" y="210" as="sourcePoint" />
        <mxPoint x="355" y="210" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg1_lbl" value="1. Clicks '5' then '5' (or physical keyboard)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1E293B;" vertex="1" connectable="0" parent="msg1">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 2: UI forwards to hook -->
    <mxCell id="msg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="355" y="240" as="sourcePoint" />
        <mxPoint x="575" y="240" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg2_lbl" value="2. inputDigit('5') -&amp;gt; display = '55'" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6B21A8;" vertex="1" connectable="0" parent="msg2">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 3: User hits '+' operator -->
    <mxCell id="msg3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="140" y="280" as="sourcePoint" />
        <mxPoint x="355" y="280" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg3_lbl" value="3. Clicks '+' operator key" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1E293B;" vertex="1" connectable="0" parent="msg3">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 4: Hook activates operator & resets display -->
    <mxCell id="msg4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DB2777;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="355" y="310" as="sourcePoint" />
        <mxPoint x="575" y="310" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg4_lbl" value="4. inputOperator('+'): prevValue=55, display='0', isNewInputRef=true" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9D174D;" vertex="1" connectable="0" parent="msg4">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 5: User types second operand 45 -->
    <mxCell id="msg5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="140" y="350" as="sourcePoint" />
        <mxPoint x="575" y="350" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg5_lbl" value="5. Types '4' then '5' -&amp;gt; fresh display replaces '0' with '45'" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1E293B;" vertex="1" connectable="0" parent="msg5">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 6: User clicks '=' -->
    <mxCell id="msg6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="140" y="390" as="sourcePoint" />
        <mxPoint x="355" y="390" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg6_lbl" value="6. Clicks '=' or presses Enter" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1E293B;" vertex="1" connectable="0" parent="msg6">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 7: Hook triggers calculate -->
    <mxCell id="msg7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DB2777;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="575" y="420" as="sourcePoint" />
        <mxPoint x="785" y="420" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg7_lbl" value="7. calculateResult(): calculateApi({operation: 'add', a: 55, b: 45})" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9D174D;" vertex="1" connectable="0" parent="msg7">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 8: Fetch sends HTTP POST -->
    <mxCell id="msg8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="785" y="460" as="sourcePoint" />
        <mxPoint x="1000" y="460" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg8_lbl" value="8. HTTP POST /api/v1/calculate (application/json)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1E3A8A;fontStyle=1;" vertex="1" connectable="0" parent="msg8">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 9: Middleware intercepts and passes -->
    <mxCell id="msg9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1000" y="500" as="sourcePoint" />
        <mxPoint x="1230" y="500" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg9_lbl" value="9. Logger records latency &amp;amp; CORS validates origin -&amp;gt; Handler dispatches service" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#0369A1;" vertex="1" connectable="0" parent="msg9">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 10: Domain Service executes arithmetic & sanitization -->
    <mxCell id="self_domain" value="10. calculator.Add(55, 45)&lt;br&gt;Sanitizes float: 100.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=9.5;fontColor=#14532D;" vertex="1" parent="1">
      <mxGeometry x="1165" y="525" width="130" height="40" as="geometry" />
    </mxCell>

    <!-- Step 11: Backend responds with 200 OK -->
    <mxCell id="msg11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1000" y="590" as="sourcePoint" />
        <mxPoint x="785" y="590" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg11_lbl" value="11. HTTP 200 OK: {&quot;success&quot;: true, &quot;result&quot;: 100}" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#14532D;fontStyle=1;" vertex="1" connectable="0" parent="msg11">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 12: API client resolves Promise -->
    <mxCell id="msg12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="785" y="630" as="sourcePoint" />
        <mxPoint x="575" y="630" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg12_lbl" value="12. Promise resolves with result: 100" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1E3A8A;" vertex="1" connectable="0" parent="msg12">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 13: Hook updates state & syncs history -->
    <mxCell id="msg13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DB2777;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="575" y="670" as="sourcePoint" />
        <mxPoint x="355" y="670" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg13_lbl" value="13. Updates display='100', expression='55 + 45 =', saves to localStorage" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9D174D;" vertex="1" connectable="0" parent="msg13">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Step 14: UI re-renders with result -->
    <mxCell id="msg14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.5;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="355" y="710" as="sourcePoint" />
        <mxPoint x="140" y="710" as="targetPoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="msg14_lbl" value="14. Dual-line Display displays '100' in bold with '55 + 45 =' formula" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6B21A8;" vertex="1" connectable="0" parent="msg14">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
    </mxCell>
    
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="clean-arch" name="3. Backend Clean Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
    <!-- Title Page 3 -->
    <mxCell id="p3_title_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="30" width="1320" height="70" as="geometry" />
    </mxCell>
    <mxCell id="p3_title" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 22px;&quot;&gt;Go Backend Clean Architecture &amp;amp; Layered Isolation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;Separation of Concerns: Entrypoint -&amp;gt; HTTP Transport -&amp;gt; Application Handlers -&amp;gt; Pure Domain Business Logic&lt;/span&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="30" width="1320" height="70" as="geometry" />
    </mxCell>

    <!-- Outer Ring / Layer 1: Entrypoint & Config -->
    <mxCell id="layer1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="60" y="130" width="1280" height="690" as="geometry" />
    </mxCell>
    <mxCell id="layer1_lbl" value="&lt;b style=&quot;font-size: 14px; color: #334155;&quot;&gt;Layer 1: Runtime Entrypoint &amp;amp; System Lifecycle (cmd/api/main.go)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;Reads PORT environment variable (default :8080), registers routes, configures graceful shutdown with os.Interrupt&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="80" y="140" width="800" height="40" as="geometry" />
    </mxCell>

    <!-- Layer 2: HTTP Transport & Middleware -->
    <mxCell id="layer2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="100" y="200" width="1200" height="590" as="geometry" />
    </mxCell>
    <mxCell id="layer2_lbl" value="&lt;b style=&quot;font-size: 14px; color: #1E40AF;&quot;&gt;Layer 2: Transport &amp;amp; Middleware Pipeline (internal/middleware)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #3B82F6;&quot;&gt;Handles cross-cutting HTTP concerns prior to request dispatching&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="120" y="210" width="600" height="40" as="geometry" />
    </mxCell>

    <!-- Middleware cards -->
    <mxCell id="card_logger" value="&lt;b&gt;LoggerMiddleware&lt;/b&gt;&lt;br&gt;Wraps response writer to capture HTTP status code, remote IP address, path, and request latency in microseconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="130" y="260" width="550" height="60" as="geometry" />
    </mxCell>

    <mxCell id="card_cors" value="&lt;b&gt;CORSMiddleware&lt;/b&gt;&lt;br&gt;Applies Access-Control-Allow-Origin (*), Allowed Methods (GET, POST, OPTIONS), and handles OPTIONS preflight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="720" y="260" width="550" height="60" as="geometry" />
    </mxCell>

    <!-- Layer 3: Application / Handlers -->
    <mxCell id="layer3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="140" y="340" width="1120" height="425" as="geometry" />
    </mxCell>
    <mxCell id="layer3_lbl" value="&lt;b style=&quot;font-size: 14px; color: #166534;&quot;&gt;Layer 3: Application Handlers &amp;amp; Protocol Adaptation (internal/handler)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #15803D;&quot;&gt;Decodes JSON payloads, maps HTTP status codes (200, 400, 405), embeds OpenAPI 3.0 specs&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="160" y="350" width="800" height="40" as="geometry" />
    </mxCell>

    <mxCell id="h_card_calc" value="&lt;b&gt;CalculateHandler&lt;/b&gt;&lt;br&gt;• Unmarshals CalculationRequest&lt;br&gt;• Maps operation enum&lt;br&gt;• Dispatches domain logic&lt;br&gt;• Encodes CalculationResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="160" y="400" width="250" height="90" as="geometry" />
    </mxCell>

    <mxCell id="h_card_op" value="&lt;b&gt;OperationHandler&lt;/b&gt;&lt;br&gt;• Extracts path value: r.PathValue(&quot;op&quot;)&lt;br&gt;• Unmarshals binary/unary operands&lt;br&gt;• Reuses calculator domain engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="440" y="400" width="250" height="90" as="geometry" />
    </mxCell>

    <mxCell id="h_card_health" value="&lt;b&gt;HealthHandler&lt;/b&gt;&lt;br&gt;• Provides uptime &amp;amp; status&lt;br&gt;• Used by Docker healthcheck&lt;br&gt;• Returns 200 OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="720" y="400" width="250" height="90" as="geometry" />
    </mxCell>

    <mxCell id="h_card_swagger" value="&lt;b&gt;SwaggerUIHandler&lt;/b&gt;&lt;br&gt;• Serves embedded OpenAPI 3.0 HTML&lt;br&gt;• Exposes /swagger.json&lt;br&gt;• Root route redirector (/, /api, /api/v1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1000" y="400" width="240" height="90" as="geometry" />
    </mxCell>

    <!-- Layer 4: Core Domain Engine -->
    <mxCell id="layer4_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2.5;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="180" y="515" width="1040" height="225" as="geometry" />
    </mxCell>
    <mxCell id="layer4_lbl" value="&lt;b style=&quot;font-size: 15px; color: #B45309;&quot;&gt;Layer 4: Core Domain Engine (internal/calculator — 100% Statement Coverage)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #D97706;&quot;&gt;The inner business core. Completely independent of HTTP, JSON, databases, and frameworks.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="200" y="525" width="800" height="35" as="geometry" />
    </mxCell>

    <!-- Operations Inside Domain -->
    <mxCell id="op_arithmetic" value="&lt;b&gt;Basic Arithmetic&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Add(a, b)&lt;br&gt;• Subtract(a, b)&lt;br&gt;• Multiply(a, b)&lt;br&gt;• Divide(a, b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1">
