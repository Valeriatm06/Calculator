<mxfile host="app.diagrams.net" modified="2026-10-04T12:00:00.000Z" agent="Antigravity/1.0" version="21.0.0" type="device">
  <diagram id="c4-containers" name="1. C4 - Diagrama de Contenedores">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
    <mxCell id="c4_p1_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;Calculadora Full-Stack — Modelo C4: Diagrama de Contenedores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #555555;&quot;&gt;Visión general limpia de los sistemas, contenedores y sus responsabilidades&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="100" y="30" width="1000" height="50" as="geometry" />
    </mxCell>
    
    <mxCell id="c4_person" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Usuario / Evaluador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Realiza cálculos matemáticos usando el teclado físico o haciendo clic en los botones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;shadow=1;arcSize=15;" vertex="1" parent="1">
      <mxGeometry x="100" y="240" width="200" height="130" as="geometry" />
    </mxCell>
    
    <mxCell id="c4_boundary" value="&lt;b style=&quot;font-size: 13px; color: #475569;&quot;&gt;Entorno de la Aplicación (Docker Compose)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="360" y="120" width="760" height="420" as="geometry" />
    </mxCell>
    
    <mxCell id="c4_frontend" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Aplicación Web (SPA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Contenedor: React 19, TypeScript, Nginx]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Interfaz gráfica con estilo Material You (colores suaves y botones circulares). Captura teclas, administra el estado y envía peticiones al API.&lt;br&gt;&lt;br&gt;&lt;i style=&quot;font-size: 10px; color: #E2E8F0;&quot;&gt;Puerto: 3000&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="400" y="210" width="280" height="190" as="geometry" />
    </mxCell>
    
    <mxCell id="c4_backend" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Microservicio REST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Contenedor: Go 1.22+, net/http]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Procesa operaciones básicas y avanzadas, sanitiza la precisión en punto flotante y registra telemetría con CORS.&lt;br&gt;&lt;br&gt;&lt;i style=&quot;font-size: 10px; color: #E2E8F0;&quot;&gt;Puerto: 8080&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="800" y="210" width="280" height="190" as="geometry" />
    </mxCell>
    
    <mxCell id="c4_storage" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Almacenamiento Local&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Storage: Browser LocalStorage]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Persiste el historial de cálculos entre recargas de página." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="445" y="430" width="190" height="90" as="geometry" />
    </mxCell>
    
    <mxCell id="c4_swagger" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Swagger UI / OpenAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Documentación Interactiva]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Embebido en el binario de Go en &lt;b&gt;/swagger&lt;/b&gt; para probar los contratos REST en vivo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="840" y="430" width="200" height="85" as="geometry" />
    </mxCell>
    
    <!-- User to Frontend -->
    <mxCell id="c4_rel_user_fe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#08427B;strokeWidth=2.5;" edge="1" parent="1" source="c4_person" target="c4_frontend">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_user_fe" value="&lt;b&gt;Usa la interfaz&lt;/b&gt;&lt;br&gt;[Clics o Teclado]&lt;br&gt;http://localhost:3000" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#08427B;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="c4_rel_user_fe">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="7" y="-2" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Frontend to Backend -->
    <mxCell id="c4_rel_fe_be" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1168BD;strokeWidth=2.5;" edge="1" parent="1" source="c4_frontend" target="c4_backend">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_fe_be" value="&lt;b&gt;Envía operaciones&lt;/b&gt;&lt;br&gt;[HTTP / JSON]&lt;br&gt;POST /api/v1/calculate" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1168BD;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="c4_rel_fe_be">
      <mxGeometry x="-0.05" relative="1" as="geometry"><mxPoint y="-2" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Frontend to Storage -->
    <mxCell id="c4_rel_fe_store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#438DD5;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c4_frontend" target="c4_storage">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_fe_store" value="Guarda historial" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E6295;fillColor=#FFFFFF;" vertex="1" connectable="0" parent="c4_rel_fe_store">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-5" as="offset" /></mxGeometry>
    </mxCell>

    <!-- Backend to Swagger -->
    <mxCell id="c4_rel_be_swag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c4_backend" target="c4_swagger">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_be_swag" value="Expone documentación" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#047857;fillColor=#FFFFFF;" vertex="1" connectable="0" parent="c4_rel_be_swag">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-5" as="offset" /></mxGeometry>
    </mxCell>
    
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-dynamic" name="2. C4 - Flujo de una Petición">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
    <!-- Title Page 2 -->
    <mxCell id="c4_p2_title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;Modelo C4: Diagrama Dinámico — Flujo Directo de una Petición&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #555555;&quot;&gt;Secuencia directa y limpia de cómo se procesa un cálculo (Ejemplo: 50 + 25 =)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="100" y="30" width="1050" height="50" as="geometry" />
    </mxCell>
    
    <mxCell id="d_user" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. Usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Escribe &lt;b&gt;50 + 25 =&lt;/b&gt;&lt;br&gt;en la pantalla o teclado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052C52;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="170" width="170" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="d_ui" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;2. Interfaz React&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Componentes UI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Actualiza el display y valida los operandos en el hook de estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="170" width="190" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="d_api" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;3. API REST (Go)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Router &amp;amp; Handler]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Registra latencia (Logger), valida CORS y decodifica el JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="640" y="170" width="200" height="110" as="geometry" />
    </mxCell>
    
    <mxCell id="d_engine" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;4. Motor de Dominio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;[Lógica Pura Go]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Ejecuta la suma (50 + 25)&lt;br&gt;y sanitiza punto flotante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="950" y="170" width="190" height="110" as="geometry" />
    </mxCell>
    
    <!-- 1 -> 2: Clic / Teclado -->
    <mxCell id="f_step1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#08427B;strokeWidth=2.5;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="d_user" target="d_ui">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_step1" value="&lt;b&gt;Paso 1&lt;/b&gt;&lt;br&gt;Evento de entrada" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#08427B;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="f_step1">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="5" y="-14" as="offset" /></mxGeometry>
    </mxCell>

    <!-- 2 -> 3: HTTP POST /api/v1/calculate -->
    <mxCell id="f_step2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1168BD;strokeWidth=2.5;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="d_ui" target="d_api">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_step2" value="&lt;b&gt;Paso 2: HTTP POST&lt;/b&gt;&lt;br&gt;{&quot;operation&quot;: &quot;add&quot;, &quot;a&quot;: 50, &quot;b&quot;: 25}" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1168BD;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="f_step2">
      <mxGeometry x="-0.05" relative="1" as="geometry"><mxPoint y="-18" as="offset" /></mxGeometry>
    </mxCell>

    <!-- 3 -> 4: Dispatch to domain engine -->
    <mxCell id="f_step3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.5;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="d_api" target="d_engine">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_step3" value="&lt;b&gt;Paso 3&lt;/b&gt;&lt;br&gt;calculator.Add(50, 25)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#047857;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="f_step3">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="5" y="-14" as="offset" /></mxGeometry>
    </mxCell>
    
    <!-- 4 -> 3: Result calculated -->
    <mxCell id="r_step4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="d_engine" target="d_api">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_step4" value="&lt;b&gt;Paso 4: Resultado&lt;/b&gt;&lt;br&gt;Retorna: 75.0" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#047857;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="r_step4">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint x="6" y="14" as="offset" /></mxGeometry>
    </mxCell>

    <!-- 3 -> 2: HTTP 200 OK Response -->
    <mxCell id="r_step5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1168BD;strokeWidth=2;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="d_api" target="d_ui">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_step5" value="&lt;b&gt;Paso 5: HTTP 200 OK&lt;/b&gt;&lt;br&gt;{&quot;success&quot;: true, &quot;result&quot;: 75}" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1168BD;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="r_step5">
      <mxGeometry x="0.05" relative="1" as="geometry"><mxPoint y="16" as="offset" /></mxGeometry>
    </mxCell>

    <!-- 2 -> 1: Final Display Update -->
    <mxCell id="r_step6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#08427B;strokeWidth=2;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="d_ui" target="d_user">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="lbl_step6" value="&lt;b&gt;Paso 6: Renderizado&lt;/b&gt;&lt;br&gt;Muestra 75 en pantalla&lt;br&gt;&amp;amp; guarda en historial" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#08427B;fillColor=#FFFFFF;rounded=1;" vertex="1" connectable="0" parent="r_step6">
      <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint x="6" y="18" as="offset" /></mxGeometry>
    </mxCell>
    
    <mxCell id="summary_box" value="&lt;b style=&quot;font-size: 13px; color: #1E293B;&quot;&gt;Resumen del Flujo de una Petición&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size: 11px; text-align: left; width: 100%; border-collapse: collapse; margin-top: 6px;&quot;&gt;&lt;tr style=&quot;background: #F1F5F9;&quot;&gt;&lt;th style=&quot;padding: 5px; border: 1px solid #CBD5E1;&quot;&gt;Etapa&lt;/th&gt;&lt;th style=&quot;padding: 5px; border: 1px solid #CBD5E1;&quot;&gt;Componente&lt;/th&gt;&lt;th style=&quot;padding: 5px; border: 1px solid #CBD5E1;&quot;&gt;Acción / Descripción&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;&lt;b&gt;Entrada&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;Usuario -&amp;gt; UI&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;El usuario presiona teclas numéricas y operadores. La UI actualiza la fórmula en vivo.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;&lt;b&gt;Transporte&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;React -&amp;gt; Go API&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;Al presionar &lt;b&gt;=&lt;/b&gt;, React emite &lt;b&gt;POST /api/v1/calculate&lt;/b&gt; con payload JSON.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;&lt;b&gt;Procesamiento&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;Backend Go&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;Middleware registra latencia, handler valida operando y motor ejecuta cálculo sanitizado.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;&lt;b&gt;Respuesta&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;Go API -&amp;gt; React&lt;/td&gt;&lt;td style=&quot;padding: 4px; border: 1px solid #CBD5E1;&quot;&gt;Retorna &lt;b&gt;200 OK&lt;/b&gt; con el resultado numérico. React renderiza y guarda en &lt;b&gt;localStorage&lt;/b&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="340" width="1000" height="150" as="geometry" />
    </mxCell>
    
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>